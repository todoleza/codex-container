FROM fedora:44

ARG TZ
ENV TZ="${TZ}"

ARG USERNAME=node

RUN dnf -y makecache

# DNF_DROPINS

RUN useradd --create-home "${USERNAME}" \
  && mkdir -p /usr/local/share/npm-global \
  && chown -R "${USERNAME}:${USERNAME}" /usr/local/share

COPY container-runtime/codex /usr/local/bin/codex
COPY container-runtime/init /usr/local/bin/codex-container-init
COPY container-runtime/profile.sh /usr/local/share/codex-container/profile.sh

RUN chmod 755 /usr/local/bin/codex /usr/local/bin/codex-container-init /usr/local/share/codex-container/profile.sh \
  && printf '%s\n' 'source /usr/local/share/codex-container/profile.sh' > /etc/profile.d/codex-container.sh \
  && printf '%s\n' 'source /usr/local/share/codex-container/profile.sh' >> /home/"${USERNAME}"/.bashrc

USER "${USERNAME}"

ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH="${PATH}:/usr/local/share/npm-global/bin"

COPY dist/codex.tgz codex.tgz

RUN npm install -g codex.tgz \
  && npm cache clean --force \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/node_modules/.cache \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/tests \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/docs

ENV CODEX_UNSAFE_ALLOW_NO_SANDBOX=1
ENV CODEX_SANDBOX_MODE=danger-full-access
ENV CODEX_APPROVAL_POLICY=on-request
ENV CODEX_DANGEROUS_BYPASS=0
