FROM alpine:3.22

RUN apk add --no-cache \
    bash \
    bind-tools \
    iproute2 \
    nftables

RUN mkdir -p /etc/codex-firewall

COPY scripts/firewall-common.sh /usr/local/lib/codex-firewall/
COPY scripts/firewall-init.sh /usr/local/bin/firewall-init
COPY scripts/firewall-allow-domain.sh /usr/local/bin/firewall-allow-domain
COPY scripts/firewall-allow-address.sh /usr/local/bin/firewall-allow-address
COPY scripts/firewall-reload.sh /usr/local/bin/firewall-reload
COPY scripts/firewall-list.sh /usr/local/bin/firewall-list

RUN chmod 500 /usr/local/bin/firewall-init \
    /usr/local/bin/firewall-allow-domain \
    /usr/local/bin/firewall-allow-address \
    /usr/local/bin/firewall-reload \
    /usr/local/bin/firewall-list \
  && chmod 500 /usr/local/lib/codex-firewall/firewall-common.sh
