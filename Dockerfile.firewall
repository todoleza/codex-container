FROM alpine:3.22

RUN apk add --no-cache \
    bash \
    bind-tools \
    iproute2 \
    socat \
    nftables \
    tzdata

RUN mkdir -p /etc/codex-firewall

COPY firewall/firewall-common /usr/local/lib/codex-firewall/firewall-common.sh
COPY firewall/firewall-init \
     firewall/firewall-allow-domain \
     firewall/firewall-allow-address \
     firewall/firewall-reload \
     firewall/firewall-list \
     /usr/local/bin/

RUN chmod 500 /usr/local/bin/firewall-init \
    /usr/local/bin/firewall-allow-domain \
    /usr/local/bin/firewall-allow-address \
    /usr/local/bin/firewall-reload \
    /usr/local/bin/firewall-list \
  && chmod 500 /usr/local/lib/codex-firewall/firewall-common.sh
