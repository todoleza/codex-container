#!/bin/bash
set -euo pipefail

STATE_DIR="${CODEX_FIREWALL_STATE_DIR:-/etc/codex-firewall}"
DOMAINS_FILE="${STATE_DIR}/domains.txt"
IPV4_FILE="${STATE_DIR}/ipv4.txt"
IPV6_FILE="${STATE_DIR}/ipv6.txt"
RESOLVED_IPV4_FILE="${STATE_DIR}/resolved_ipv4.txt"
RESOLVED_IPV6_FILE="${STATE_DIR}/resolved_ipv6.txt"
DNS_IPV4_FILE="${STATE_DIR}/dns_ipv4.txt"
DNS_IPV6_FILE="${STATE_DIR}/dns_ipv6.txt"
STATUS_FILE="${STATE_DIR}/status.env"
DNS_CACHE_DIR="${STATE_DIR}/dns-cache"

: "${CODEX_FIREWALL_DNS_TOOL:=dig}"
: "${CODEX_FIREWALL_DNS_PARALLELISM:=32}"
: "${CODEX_FIREWALL_DNS_BATCH_SIZE:=10}"
: "${CODEX_FIREWALL_DNS_CACHE_TTL:=300}"
: "${CODEX_FIREWALL_DNS_TIMEOUT:=${CODEX_FIREWALL_DIG_TIMEOUT:-2}}"
: "${CODEX_FIREWALL_DNS_TRIES:=${CODEX_FIREWALL_DIG_TRIES:-1}}"
CODEX_FIREWALL_DIG_TIMEOUT="${CODEX_FIREWALL_DNS_TIMEOUT}"
CODEX_FIREWALL_DIG_TRIES="${CODEX_FIREWALL_DNS_TRIES}"

ensure_state_dir() {
  mkdir -p "${STATE_DIR}"
  touch "${DOMAINS_FILE}" "${IPV4_FILE}" "${IPV6_FILE}"
}

append_unique_line() {
  local file="$1"
  local entry="$2"

  if grep -Fqx -- "${entry}" "${file}"; then
    return 0
  fi

  printf '%s\n' "${entry}" >> "${file}"
}

validate_domain() {
  local domain="$1"

  [[ "${domain}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]\.[A-Za-z]{2,}$ ]]
}

validate_address() {
  local address="$1"

  if [[ "${address}" == *:* ]]; then
    [[ "${address}" =~ ^[0-9A-Fa-f:/]+$ ]]
    return
  fi

  [[ "${address}" =~ ^[0-9./]+$ ]]
}

is_ipv6_address() {
  local address="$1"
  [[ "${address}" == *:* ]]
}

resolver_addresses() {
  awk '/^nameserver / { print $2 }' /etc/resolv.conf
}

write_status() {
  local mode="$1"

  {
    printf 'CODEX_FIREWALL_MODE=%s\n' "${mode}"
    printf 'CODEX_FIREWALL_UPDATED_EPOCH=%s\n' "$(date +%s)"
  } > "${STATUS_FILE}"
}
