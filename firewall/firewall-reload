#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f /usr/local/lib/codex-firewall/firewall-common.sh ]; then
  # shellcheck disable=SC1091
  source /usr/local/lib/codex-firewall/firewall-common.sh
else
  # shellcheck disable=SC1091
  source "${script_dir}/firewall-common"
fi

ensure_state_dir
export CODEX_FIREWALL_DNS_TOOL
export CODEX_FIREWALL_DNS_PARALLELISM
export CODEX_FIREWALL_DNS_BATCH_SIZE
export CODEX_FIREWALL_DNS_CACHE_TTL
export CODEX_FIREWALL_DNS_TIMEOUT
export CODEX_FIREWALL_DNS_TRIES

tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

allowed_ipv4_file="${tmpdir}/allowed_ipv4.txt"
allowed_ipv6_file="${tmpdir}/allowed_ipv6.txt"
dns_ipv4_file="${tmpdir}/dns_ipv4.txt"
dns_ipv6_file="${tmpdir}/dns_ipv6.txt"
domains_sorted_file="${tmpdir}/domains.txt"
resolved_dns_file="${tmpdir}/resolved_dns.txt"
nft_file="${tmpdir}/rules.nft"

touch "${allowed_ipv4_file}" "${allowed_ipv6_file}" "${dns_ipv4_file}" "${dns_ipv6_file}"

if ! [[ "${CODEX_FIREWALL_DNS_TIMEOUT}" =~ ^0\.[0-9]*[1-9][0-9]*$ ]]; then
  echo "Error: CODEX_FIREWALL_DNS_TIMEOUT must be greater than zero and less than one second." >&2
  exit 1
fi
if ! [[ "${CODEX_FIREWALL_DNS_TRIES}" =~ ^[1-5]$ ]]; then
  echo "Error: CODEX_FIREWALL_DNS_TRIES must be between 1 and 5." >&2
  exit 1
fi

emit_set_elements() {
  local file="$1"

  # An empty named set is valid, but an empty multiline elements block is not.
  # Omit the optional elements clause when there is nothing to populate.
  [ -s "${file}" ] || return 0

  echo "    elements = {"
  sed 's/^/      /; s/$/,/' "${file}"
  echo "    }"
}

case "${CODEX_FIREWALL_DNS_TOOL}" in
  dig|kdig|drill)
    if ! command -v "${CODEX_FIREWALL_DNS_TOOL}" >/dev/null 2>&1; then
      echo "Error: CODEX_FIREWALL_DNS_TOOL=${CODEX_FIREWALL_DNS_TOOL} is not installed." >&2
      exit 1
    fi
    ;;
  *)
    echo "Error: unsupported CODEX_FIREWALL_DNS_TOOL=${CODEX_FIREWALL_DNS_TOOL}." >&2
    echo "Set CODEX_FIREWALL_DNS_TOOL=dig, kdig, or drill." >&2
    exit 1
    ;;
esac

while IFS= read -r entry; do
  [ -n "${entry}" ] || continue
  printf '%s\n' "${entry}" >> "${allowed_ipv4_file}"
done < "${IPV4_FILE}"

while IFS= read -r entry; do
  [ -n "${entry}" ] || continue
  printf '%s\n' "${entry}" >> "${allowed_ipv6_file}"
done < "${IPV6_FILE}"

sed '/^$/d' "${DOMAINS_FILE}" | sort -u > "${domains_sorted_file}"

resolve_domains() {
  local chunks_dir="${tmpdir}/dns-chunks"

  if [ ! -s "${domains_sorted_file}" ]; then
    : > "${resolved_dns_file}"
    return 0
  fi

  mkdir -p "${chunks_dir}"
  split -l "${CODEX_FIREWALL_DNS_BATCH_SIZE}" -d "${domains_sorted_file}" "${chunks_dir}/chunk-"

  find "${chunks_dir}" -type f -name "chunk-*" -print0 \
    | xargs -0 -r -P "${CODEX_FIREWALL_DNS_PARALLELISM}" -I{} bash -c '
    set -euo pipefail
    chunk="$1"
    run_query_attempt() {
      local record_type="$1"
      local query_file="$2"

      case "${CODEX_FIREWALL_DNS_TOOL}" in
        dig)
          timeout "${CODEX_FIREWALL_DNS_TIMEOUT}" \
            dig +timeout=1 +tries=1 +short -f "${query_file}" 2>/dev/null
          ;;
        kdig)
          xargs -r timeout "${CODEX_FIREWALL_DNS_TIMEOUT}" \
            kdig +timeout=1 +retry=0 +short < "${query_file}" 2>/dev/null
          ;;
        drill)
          timeout "${CODEX_FIREWALL_DNS_TIMEOUT}" bash -c '\''
            record_type="$1"
            query_file="$2"
            while read -r domain _; do
              drill -Q "${domain}" "${record_type}" 2>/dev/null || true
            done < "${query_file}"
          '\'' bash "${record_type}" "${query_file}"
          ;;
      esac
    }

    query_with_retries() {
      local record_type="$1"
      local query_file="${chunk}.${record_type}"
      local attempt
      local status

      sed "s/$/ ${record_type}/" "${chunk}" > "${query_file}"
      for ((attempt = 1; attempt <= CODEX_FIREWALL_DNS_TRIES; attempt++)); do
        if run_query_attempt "${record_type}" "${query_file}"; then
          return 0
        else
          status=$?
        fi
      done
      printf "Warning: %s DNS batch exhausted %s attempts (last status %s); continuing with valid answers only.\n" \
        "${record_type}" "${CODEX_FIREWALL_DNS_TRIES}" "${status}" >&2
      return 0
    }

    query_with_retries A \
      | while IFS= read -r record; do
        [[ "${record}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue
        printf "4 %s\n" "${record}"
      done || true

    query_with_retries AAAA \
      | while IFS= read -r record; do
        [[ "${record}" == *:* && "${record}" =~ ^[0-9A-Fa-f:]+$ ]] || continue
        printf "6 %s\n" "${record}"
      done || true
  ' bash {} > "${resolved_dns_file}"
}

load_dns_cache() {
  local cache_hash_file="${DNS_CACHE_DIR}/domains.sha256"
  local cache_epoch_file="${DNS_CACHE_DIR}/updated_epoch"
  local cache_ipv4_file="${DNS_CACHE_DIR}/resolved_ipv4.txt"
  local cache_ipv6_file="${DNS_CACHE_DIR}/resolved_ipv6.txt"
  local domains_hash
  local cache_hash
  local cache_epoch
  local now

  dns_cache_file_valid() {
    local family="$1"
    local file="$2"
    local record

    while IFS= read -r record; do
      case "${family}" in
        4) [[ "${record}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1 ;;
        6) [[ "${record}" == *:* && "${record}" =~ ^[0-9A-Fa-f:]+$ ]] || return 1 ;;
      esac
    done < "${file}"
  }

  if [ "${CODEX_FIREWALL_DNS_CACHE_TTL}" = "0" ]; then
    return 1
  fi

  [ -f "${cache_hash_file}" ] && [ -f "${cache_epoch_file}" ] && [ -f "${cache_ipv4_file}" ] && [ -f "${cache_ipv6_file}" ] || return 1
  dns_cache_file_valid 4 "${cache_ipv4_file}" || return 1
  dns_cache_file_valid 6 "${cache_ipv6_file}" || return 1

  domains_hash="$(sha256sum "${domains_sorted_file}" | awk '{print $1}')"
  cache_hash="$(sed -n '1p' "${cache_hash_file}")"
  [ "${domains_hash}" = "${cache_hash}" ] || return 1

  cache_epoch="$(sed -n '1p' "${cache_epoch_file}")"
  [[ "${cache_epoch}" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  if (( now - cache_epoch > CODEX_FIREWALL_DNS_CACHE_TTL )); then
    return 1
  fi

  cat "${cache_ipv4_file}" >> "${allowed_ipv4_file}"
  cat "${cache_ipv6_file}" >> "${allowed_ipv6_file}"
  return 0
}

write_dns_cache() {
  mkdir -p "${DNS_CACHE_DIR}"
  sha256sum "${domains_sorted_file}" | awk '{print $1}' > "${DNS_CACHE_DIR}/domains.sha256"
  awk '$1 == "4" { print $2 }' "${resolved_dns_file}" | sort -u > "${DNS_CACHE_DIR}/resolved_ipv4.txt"
  awk '$1 == "6" { print $2 }' "${resolved_dns_file}" | sort -u > "${DNS_CACHE_DIR}/resolved_ipv6.txt"
  date +%s > "${DNS_CACHE_DIR}/updated_epoch"
}

if ! load_dns_cache; then
  resolve_domains
  write_dns_cache
  awk '$1 == "4" { print $2 }' "${resolved_dns_file}" >> "${allowed_ipv4_file}"
  awk '$1 == "6" { print $2 }' "${resolved_dns_file}" >> "${allowed_ipv6_file}"
fi

while IFS= read -r resolver; do
  [ -n "${resolver}" ] || continue
  if is_ipv6_address "${resolver}"; then
    printf '%s\n' "${resolver}" >> "${dns_ipv6_file}"
  else
    printf '%s\n' "${resolver}" >> "${dns_ipv4_file}"
  fi
done < <(resolver_addresses)

sort -u -o "${allowed_ipv4_file}" "${allowed_ipv4_file}"
sort -u -o "${allowed_ipv6_file}" "${allowed_ipv6_file}"
sort -u -o "${dns_ipv4_file}" "${dns_ipv4_file}"
sort -u -o "${dns_ipv6_file}" "${dns_ipv6_file}"

cp "${allowed_ipv4_file}" "${RESOLVED_IPV4_FILE}"
cp "${allowed_ipv6_file}" "${RESOLVED_IPV6_FILE}"
cp "${dns_ipv4_file}" "${DNS_IPV4_FILE}"
cp "${dns_ipv6_file}" "${DNS_IPV6_FILE}"

{
  # Keep teardown and replacement in one nftables transaction.  destroy is
  # idempotent: it does not fail when the table does not exist.
  echo "destroy table inet codex_firewall"
  echo "table inet codex_firewall {"
  echo "  set allowed_v4 {"
  echo "    type ipv4_addr"
  echo "    flags interval"
  echo "    auto-merge"
  emit_set_elements "${allowed_ipv4_file}"
  echo "  }"
  echo "  set allowed_v6 {"
  echo "    type ipv6_addr"
  echo "    flags interval"
  echo "    auto-merge"
  emit_set_elements "${allowed_ipv6_file}"
  echo "  }"
  echo "  set dns_v4 {"
  echo "    type ipv4_addr"
  emit_set_elements "${dns_ipv4_file}"
  echo "  }"
  echo "  set dns_v6 {"
  echo "    type ipv6_addr"
  emit_set_elements "${dns_ipv6_file}"
  echo "  }"
  echo "  chain input {"
  echo "    type filter hook input priority 0"
  echo "    policy accept"
  echo "  }"
  echo "  chain forward {"
  echo "    type filter hook forward priority 0"
  echo "    policy drop"
  echo "    reject with icmpx type admin-prohibited"
  echo "  }"
  echo "  chain output {"
  echo "    type filter hook output priority 0"
  echo "    policy drop"
  echo "    ct state established,related accept"
  echo "    oifname \"lo\" accept"
  echo "    meta nfproto ipv4 ip daddr @dns_v4 udp dport 53 accept"
  echo "    meta nfproto ipv4 ip daddr @dns_v4 tcp dport 53 accept"
  echo "    meta nfproto ipv6 ip6 daddr @dns_v6 udp dport 53 accept"
  echo "    meta nfproto ipv6 ip6 daddr @dns_v6 tcp dport 53 accept"
  echo "    meta l4proto ipv6-icmp ip6 daddr fe80::/10 accept"
  echo "    meta l4proto ipv6-icmp ip6 daddr ff02::/16 accept"
  echo "    meta nfproto ipv4 ip daddr @allowed_v4 meta l4proto { tcp, udp } accept"
  echo "    meta nfproto ipv6 ip6 daddr @allowed_v6 meta l4proto { tcp, udp } accept"
  echo "    reject with icmpx type admin-prohibited"
  echo "  }"
  echo "}"
} > "${nft_file}"

# Validate the complete transaction before attempting to commit it.  The
# following nft -f is itself atomic; this check just gives a cleaner failure
# before touching the active ruleset.
nft -c -f "${nft_file}" || {
  tail -vn +1 "${nft_file}"
  false
}
nft -f "${nft_file}"
write_status enforced
