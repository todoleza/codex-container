#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f /usr/local/lib/codex-firewall/firewall-common.sh ]; then
  # shellcheck disable=SC1091
  source /usr/local/lib/codex-firewall/firewall-common.sh
else
  # shellcheck disable=SC1091
  source "${script_dir}/firewall-common"
fi

ensure_state_dir

mode="unknown"
if [ -f "${STATUS_FILE}" ]; then
  # shellcheck disable=SC1090
  source "${STATUS_FILE}"
  mode="${CODEX_FIREWALL_MODE:-unknown}"
fi

printf 'mode: %s\n' "${mode}"
printf 'domains:\n'
cat "${DOMAINS_FILE}"
printf '\nipv4:\n'
cat "${IPV4_FILE}"
printf '\nipv6:\n'
cat "${IPV6_FILE}"
printf '\nresolved_ipv4:\n'
[ -f "${RESOLVED_IPV4_FILE}" ] && cat "${RESOLVED_IPV4_FILE}"
printf '\nresolved_ipv6:\n'
[ -f "${RESOLVED_IPV6_FILE}" ] && cat "${RESOLVED_IPV6_FILE}"
printf '\ndns_ipv4:\n'
[ -f "${DNS_IPV4_FILE}" ] && cat "${DNS_IPV4_FILE}"
printf '\ndns_ipv6:\n'
[ -f "${DNS_IPV6_FILE}" ] && cat "${DNS_IPV6_FILE}"
