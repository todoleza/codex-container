#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f /usr/local/lib/codex-firewall/firewall-common.sh ]; then
  # shellcheck disable=SC1091
  source /usr/local/lib/codex-firewall/firewall-common.sh
else
  # shellcheck disable=SC1091
  source "${script_dir}/firewall-common"
fi

ensure_state_dir

if [ "$#" -gt 1 ]; then
  echo "Usage: firewall-allow-domain [DOMAIN]" >&2
  exit 1
fi

if [ "$#" -eq 1 ]; then
  domains=("$1")
else
  domains=()
  while IFS= read -r domain; do
    [ -n "${domain}" ] || continue
    domains+=("${domain}")
  done
fi

for domain in "${domains[@]}"; do
  if ! validate_domain "${domain}"; then
    echo "Invalid domain: ${domain}" >&2
    exit 1
  fi

  append_unique_line "${DOMAINS_FILE}" "${domain}"
done
