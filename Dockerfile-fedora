# vim: ft=dockerfile
FROM fedora:44

ARG TZ
ENV TZ="${TZ}"

ARG USERNAME=node

# Base tooling + Node.js 24.
#
# Notes:
# - iptables/ipset inside containers usually still need runtime capabilities,
#   e.g. CAP_NET_ADMIN, depending on what init_firewall.sh does.
# - gh is available as the GitHub CLI package in Fedora.
# - aggregate is packaged in Fedora.
RUN dnf -y install --setopt=install_weak_deps=False \
    aggregate \
    ca-certificates \
    curl \
    bind-utils \
    fzf \
    gh \
    git \
    gnupg2 \
    iproute \
    ipset \
    iptables-nft \
    jq \
    less \
    procps-ng \
    unzip \
    ripgrep \
    zsh \
    python3 \
    yamllint \
    ShellCheck \
    bubblewrap \
    nodejs24 \
    nodejs24-npm \
    ansible linux-system-roles \
  && dnf clean all \
  && rm -rf /var/cache/dnf /var/cache/libdnf5

# Match the old node image's non-root user assumption.
RUN useradd --create-home --shell /usr/bin/zsh "${USERNAME}" \
  && mkdir -p /usr/local/share/npm-global \
  && chown -R "${USERNAME}:${USERNAME}" /usr/local/share

# Set up non-root user
USER "${USERNAME}"

# Install global packages
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH="${PATH}:/usr/local/share/npm-global/bin"

# Install codex
COPY dist/codex.tgz codex.tgz

RUN npm install -g codex.tgz \
  && npm cache clean --force \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/node_modules/.cache \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/tests \
  && rm -rf /usr/local/share/npm-global/lib/node_modules/codex-cli/docs

# Inside the container we consider the environment already sufficiently locked
# down, therefore instruct Codex CLI to allow running without sandboxing.
ENV CODEX_UNSAFE_ALLOW_NO_SANDBOX=1

# Copy and set up firewall script as root.
USER root

COPY scripts/init_firewall.sh /usr/local/bin/
RUN chmod 500 /usr/local/bin/init_firewall.sh

# Drop back to non-root.
USER "${USERNAME}"
